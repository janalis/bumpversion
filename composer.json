{
    "name": "janalis/bumpversion",
    "type": "library",
    "description": "A PHP CLI to update version strings and prepare Git releases.",
    "homepage": "https://github.com/janalis/bumpversion",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/process": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Janalis\\Bumpversion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Janalis\\Bumpversion\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/bumpversion"
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=512M",
        "build": "@php -d phar.readonly=0 tools/build-phar.php",
        "verify": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test",
            "@security"
        ],
        "security": "@composer audit",
        "smoke": "@php tools/smoke.php"
    }
}
